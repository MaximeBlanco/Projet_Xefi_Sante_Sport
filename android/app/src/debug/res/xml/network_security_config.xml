<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. A local Supabase stack is served over plain HTTP, and
  Android blocks cleartext by default since API 28. The exemption is limited to
  the loopback aliases the emulator and a desktop run use, so no other host
  gains it, and the release manifest never sees this file.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
